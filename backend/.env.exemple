# ============================================
# AIPENSA Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] must be set.
# Variables marked [OPTIONAL] have sensible defaults.
#
# For testing, copy .env.test (already committed) and adjust values.

# ---- General ----
NODE_ENV=production
BACKEND_URL=http://localhost        # [REQUIRED] Public backend URL
FRONTEND_URL=http://localhost:3000  # [REQUIRED] Public frontend URL
PROXY_PORT=8081                     # [OPTIONAL] Proxy port
PORT=8081                           # [OPTIONAL] App port

# ---- SSL ----
CERTIFICADOS=false
HTTPS=true
SSL_CRT_FILE=
SSL_KEY_FILE=

# ---- Database (PostgreSQL) ----
DB_HOST=localhost    # [REQUIRED]
DB_DIALECT=postgres
DB_PORT=5432
DB_USER=             # [REQUIRED]
DB_PASS=             # [REQUIRED]
DB_NAME=             # [REQUIRED]

TIMEOUT_TO_IMPORT_MESSAGE=1000

# ---- Redis ----
REDIS_URI=redis://:yourPassword@127.0.0.1:6379  # [REQUIRED]
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000
REDIS_SECRET_KEY=

# ---- Auth Secrets ----
JWT_SECRET=          # [REQUIRED] Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=  # [REQUIRED] Generate with: openssl rand -hex 32
ADMIN_PASSWORD=      # [OPTIONAL] Default admin password for new companies

# ---- Company / API Tokens ----
COMPANY_TOKEN=       # [REQUIRED] Unique strong token — generate with: openssl rand -hex 32
VERIFY_TOKEN=        # [REQUIRED] Webhook verification token

# ---- CORS ----
# EXTRA_CORS_ORIGINS=   # [OPTIONAL] Comma-separated extra origins (e.g. "https://admin.example.com,https://other.example.com")

# ---- Queue Concurrency ----
# QUEUE_CONCURRENCY_MESSAGE=3     # [OPTIONAL] Message queue workers (default: 3)
# QUEUE_CONCURRENCY_CAMPAIGN=3    # [OPTIONAL] Campaign queue workers (default: 3)
# QUEUE_CONCURRENCY_CONTACT=5     # [OPTIONAL] Contact preparation workers (default: 5)
# QUEUE_CONCURRENCY_SCHEDULE=3    # [OPTIONAL] Scheduled message workers (default: 3)

# ---- Stripe ----
STRIPE_PRIVATE=
STRIPE_WEBHOOK_SECRET=
STRIPE_OK_URL=
STRIPE_CANCEL_URL=

# ---- Facebook / Meta ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Email (SMTP) ----
MAIL_HOST="smtp.gmail.com"
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_PORT="465"

# ---- Perfex CRM ----
PERFEX_URL=
PERFEX_MODULE=

# ---- AI / Image Generation ----
# OPENAI_API_KEY=           # [OPTIONAL] OpenAI API key
# OPENROUTER_API_KEY=       # [OPTIONAL] OpenRouter API key
# DAILY_IMAGE_LIMIT=3       # [OPTIONAL] Max AI images per day

# ---- Sentry ----
# SENTRY_DSN=               # [OPTIONAL] Sentry DSN for error tracking

# ---- Bull Queue Admin (optional) ----
# REDIS_URI_ACK=redis://:123456@127.0.0.1:6379
# BULL_BOARD=true
# BULL_USER=admin
# BULL_PASS=123456

# ---- Limits (optional) ----
# USER_LIMIT=10000
# CONNECTIONS_LIMIT=100000
# CLOSED_SEND_BY_ME=true
